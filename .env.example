# Copy to .env for local development. Never commit .env.
# Production values come from the cloud secret manager (§8.5), never from a file.

DISPUTESHIELD_DEBUG=1
DISPUTESHIELD_SECRET_KEY=dev-only-not-a-real-secret
DISPUTESHIELD_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres. Direct locally; through PgBouncer (56432) in the compose stack and in
# production. The app role is deliberately NOT the owner: it must lack UPDATE and
# DELETE on the audit table (§8.3), which disputeshield_doctor verifies.
DISPUTESHIELD_DATABASE_URL=postgres://disputeshield:disputeshield@localhost:55433/disputeshield

# Migrations run as the owner, direct to Postgres. The app never connects this way.
DISPUTESHIELD_DATABASE_DIRECT_URL=postgres://disputeshield_owner:disputeshield@localhost:55433/disputeshield

# Read replica for analytics and exports. Points at the primary locally.
DISPUTESHIELD_DATABASE_REPLICA_URL=postgres://disputeshield:disputeshield@localhost:55433/disputeshield

# Two Redis instances on purpose (§11.1): flushing the cache must not destroy the task queue.
DISPUTESHIELD_REDIS_BROKER_URL=redis://localhost:56380/0
DISPUTESHIELD_REDIS_CACHE_URL=redis://localhost:56381/0

# Envelope encryption (§8.4). Local development uses a static key; production uses kms://
DISPUTESHIELD_ENCRYPTION_KEY_REF=local://dev-master-key

DISPUTESHIELD_WIDGET_ORIGIN=http://localhost:5173

# Where the widget may send requests, as it appears in the CSP's connect-src.
# Configured rather than derived from the Host header — see disputeshield/conf.py.
DISPUTESHIELD_API_ORIGIN=http://127.0.0.1:8011
DISPUTESHIELD_ENVIRONMENT=test
