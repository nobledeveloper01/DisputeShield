# Copy to .env for local development. Never commit .env.
# Production values come from the cloud secret manager (§8.5), never from a file.

DISPUTESHIELD_DEBUG=1
DISPUTESHIELD_SECRET_KEY=dev-only-not-a-real-secret
DISPUTESHIELD_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres. The app role is deliberately NOT the owner: it must lack UPDATE and
# DELETE on the audit table (§8.3), which disputeshield_doctor verifies.
DISPUTESHIELD_DATABASE_URL=postgres://disputeshield:disputeshield@localhost:5432/disputeshield

# Direct connection, used only by migrations and by the isolation suite's pooled/unpooled comparison.
DISPUTESHIELD_DATABASE_DIRECT_URL=postgres://disputeshield_owner:disputeshield@localhost:5432/disputeshield

# Read replica for analytics and exports. Points at the primary locally.
DISPUTESHIELD_DATABASE_REPLICA_URL=postgres://disputeshield:disputeshield@localhost:5432/disputeshield

# Two Redis instances on purpose (§11.1): flushing the cache must not destroy the task queue.
DISPUTESHIELD_REDIS_BROKER_URL=redis://localhost:6379/0
DISPUTESHIELD_REDIS_CACHE_URL=redis://localhost:6380/0

# Envelope encryption (§8.4). Local development uses a static key; production uses kms://
DISPUTESHIELD_ENCRYPTION_KEY_REF=local://dev-master-key

DISPUTESHIELD_WIDGET_ORIGIN=http://localhost:5173
DISPUTESHIELD_ENVIRONMENT=test
